{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wisent-ai/wisent-desktop-update/release-manifest.schema.json",
  "title": "Wisent desktop release manifest",
  "description": "What a desktop app's release build needs from its repository. The oldest macOS a release is offered to is read from the built app's own LSMinimumSystemVersion, so the manifest does not repeat it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product",
    "bundle_id",
    "bundle_path",
    "build_command",
    "archive_name"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "product": { "$ref": "#/$defs/text" },
    "bundle_id": { "$ref": "#/$defs/text" },
    "bundle_path": { "$ref": "#/$defs/text" },
    "build_command": { "$ref": "#/$defs/text" },
    "archive_name": {
      "type": "string",
      "pattern": "^[^/]+\\{version\\}[^/]*\\.zip$"
    },
    "backend": { "$ref": "#/$defs/pinnedSource" },
    "backends": {
      "description": "Every sibling repository the app builds against; `contains` with any item refuses an empty list.",
      "type": "array",
      "contains": true,
      "items": { "$ref": "#/$defs/pinnedSource" }
    }
  },
  "not": { "required": ["backend", "backends"] },
  "$defs": {
    "text": {
      "description": "A string with at least one character.",
      "type": "string",
      "pattern": "."
    },
    "pinnedSource": {
      "description": "Product source from another repository, checked out at one full commit read from revision_file, at a path inside the workspace.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision_file", "checkout_path"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "revision_file": { "$ref": "#/$defs/text" },
        "checkout_path": { "type": "string", "pattern": "^(?!/)(?!\\.\\.(/|$))(?!.*/\\.\\.(/|$)).+$" }
      }
    }
  }
}
